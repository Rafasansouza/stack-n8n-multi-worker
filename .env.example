# =============================================================================
# N8N Server Configuration - Development Environment
# =============================================================================
# IMPORTANTE: Copie este arquivo para .env e configure as variáveis
# NUNCA commite o arquivo .env com valores reais

# -----------------------------------------------------------------------------
# Versão do n8n
# -----------------------------------------------------------------------------
N8N_VERSION=2.0.3

# -----------------------------------------------------------------------------
# Segurança - GERAR VALORES ÚNICOS ANTES DE USAR
# -----------------------------------------------------------------------------
# CRÍTICO: N8N_ENCRYPTION_KEY é usada para criptografar credenciais e dados sensíveis
# Uma vez definida, NÃO PODE SER ALTERADA sem perder dados criptografados
# Gerar com: openssl rand -base64 32
N8N_ENCRYPTION_KEY=

# Senha do PostgreSQL
# Gerar com: openssl rand -base64 24
POSTGRES_PASSWORD=

# Senha do Redis
# Gerar com: openssl rand -base64 24
REDIS_PASSWORD=

# Token de autenticação para task runners (Python/JavaScript)
# Gerar com: openssl rand -base64 32
N8N_RUNNERS_GRANT_TOKEN=

# -----------------------------------------------------------------------------
# Configurações do n8n
# -----------------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# -----------------------------------------------------------------------------
# Timezone
# -----------------------------------------------------------------------------
TZ=America/Sao_Paulo
GENERIC_TIMEZONE=America/Sao_Paulo

# -----------------------------------------------------------------------------
# Backup do PostgreSQL
# -----------------------------------------------------------------------------
# Retenção de backups em dias
BACKUP_RETENTION_DAYS=7

# Horário do backup (formato cron)
BACKUP_SCHEDULE=0 2 * * *

# -----------------------------------------------------------------------------
# Oracle Instant Client (SHA256 para validação)
# -----------------------------------------------------------------------------
# SHA256 do arquivo instantclient-basiclite-linux.x64-19.19.0.0.0dbru.zip
# Verificar em: https://www.oracle.com/database/technologies/instant-client/linux-x86-64-downloads.html
ORACLE_IC_SHA256=8d8c222d89be761c5e44baa9f6b688e11830f0a82e84b5b0f7e88ff58cff4b65

# -----------------------------------------------------------------------------
# WAHA (WhatsApp HTTP API)
# -----------------------------------------------------------------------------
# Webhook URL para receber mensagens (opcional)
WAHA_WEBHOOK_URL=

# API Key para autenticação (opcional, mas recomendado)
# Gerar com: openssl rand -hex 16
WAHA_API_KEY=

# Mostrar QR Code no console (true/false)
WAHA_PRINT_QR=true

# Nível de log (error, warn, info, debug)
WAHA_LOG_LEVEL=info

# Habilitar Swagger UI (true/false)
WAHA_SWAGGER_ENABLED=true

# Credenciais Swagger UI e Dashboard
# IMPORTANTE: Defina senhas fortes aqui para evitar regeneração a cada restart
# Gerar com: openssl rand -hex 16
WAHA_SWAGGER_USERNAME=admin
WAHA_SWAGGER_PASSWORD=admin
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=admin
